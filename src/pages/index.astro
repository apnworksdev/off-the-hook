		<autoplay-video class="bg-media">
			<img class="bg-poster" data-poster="desktop" src="/images/oth_poster.webp" alt="" loading="eager" decoding="async" />
			<video class="bg-video" data-video="desktop" muted loop playsinline preload="metadata" aria-hidden="true">
				<source data-src="/videos/oth_video.mp4" type="video/mp4" />
			</video>
		</autoplay-video>
	</div>
	<main class="content">

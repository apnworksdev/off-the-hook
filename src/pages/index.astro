---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/newsletter/NewsletterSignup.astro';

import Logo from '../components/icons/Logo.astro';
import Dates from '../components/icons/Dates.astro';
import AsideIcons from '../components/icons/AsideIcons.astro';
import '../styles/home.css';
